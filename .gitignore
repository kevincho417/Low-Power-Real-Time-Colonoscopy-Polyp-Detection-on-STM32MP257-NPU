!models/int8/yolo26n_polyp_416_full_integer_int8.tflite
!models/int8/yolo26n_polyp_416_full_integer_int8_1.nb

# Keep compact result summaries, but not generated demo videos or raw validation dumps
runs/**
!runs/
!runs/.gitkeep
!runs/multidata_compare_eval_4models/
!runs/multidata_compare_eval_4models/*.csv
!runs/multidata_compare_eval_4models/*.json
!runs/multidata_compare_eval_4models/report_figures/
!runs/multidata_compare_eval_4models/report_figures/*.png
